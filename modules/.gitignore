# Ignore everything so if we update via git, nothing is overwritten

/*
/*/
!.gitignore
!/Awards
!/Importer
!/Installer
!/Updater
!/Vacentral
!/ModulesManager
!/DisposableBasic
!/SmartCARS3phpVMS7Api

# VA owned modules (to be extracted to their own repos and pinned as submodules)
!/VmsOpenOps
!/VmsOpenFileManager
!/TestABC

# DisposableSpecial y CHJumpSeat NO se versionan: sus licencias prohiben
# redistribuir el codigo. Se instalan aparte y sus parches viven en patches/.
# DisposableBasic si se versiona, pero como submodulo (apunta a su repo upstream).
