+        if (!$isAdmin) {
+            abort(403, 'No tienes permiso para realizar esta acción.');
+        }
+
+        $assignmentId = $request->assignment_id;
+        $newFlightId = $request->flight_id;
+
+        $assignment = DS_Assignment::find($assignmentId);
+        if (!$assignment) {
+            flash()->error('Asignación no encontrada');
